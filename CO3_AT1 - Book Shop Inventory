#include <iostream>
#include <string>
using namespace std;

class books
{
private:
    string author;
    string title;
    double price;
    string publisher;
    int stock;

    // Private function
    void updatePrice(double newPrice)
    {
        price = newPrice;
    }

public:

    static int successfulTransactions;
    static int unsuccessfulTransactions;

    // Constructor
    books(
        string a,
        string t,
        double p,
        string pub,
        int s
    )
    {
        author = a;
        title = t;
        price = p;
        publisher = pub;
        stock = s;
    }

    bool searchBook(string searchTitle, string searchAuthor)
    {
        return (title == searchTitle && author == searchAuthor);
    }

    void displayDetails()
    {
        cout << "\n----- Book Details -----" << endl;
        cout << "Title: " << title << endl;
        cout << "Author: " << author << endl;
        cout << "Price: Rs. " << price << endl;
        cout << "Publisher: " << publisher << endl;
        cout << "Stock: " << stock << endl;
    }

    void purchase(int copies)
    {
        if (copies <= stock)
        {
            double totalCost = copies * price;

            stock = stock - copies;

            cout << "\nTransaction successful!" << endl;
            cout << "Copies purchased: " << copies << endl;
            cout << "Total cost: Rs. " << totalCost << endl;
            cout << "Remaining stock: " << stock << endl;

            successfulTransactions++;
        }
        else
        {
            cout << "\nRequired copies not in stock." << endl;
            unsuccessfulTransactions++;
        }
    }

    void changePrice(double newPrice)
    {
        updatePrice(newPrice);
        cout << "Price updated successfully." << endl;
    }

    static void showStatistics()
    {
        cout << "\n----- Transaction Statistics -----" << endl;
        cout << "Successful Transactions: "
             << successfulTransactions << endl;

        cout << "Unsuccessful Transactions: "
             << unsuccessfulTransactions << endl;
    }
};

int books::successfulTransactions = 0;
int books::unsuccessfulTransactions = 0;

int main()
{
    books book1(
        "R.K. Narayan",
        "Malgudi Days",
        350,
        "Indian Publisher",
        10
    );

    books book2(
        "Chetan Bhagat",
        "Five Point Someone",
        300,
        "Rupa Publications",
        5
    );

    string title, author;
    int copies;

    cout << "Enter book title: ";
    getline(cin, title);

    cout << "Enter author name: ";
    getline(cin, author);

    if (book1.searchBook(title, author))
    {
        book1.displayDetails();

        cout << "\nEnter number of copies required: ";
        cin >> copies;

        book1.purchase(copies);
    }
    else if (book2.searchBook(title, author))
    {
        book2.displayDetails();

        cout << "\nEnter number of copies required: ";
        cin >> copies;

        book2.purchase(copies);
    }
    else
    {
        cout << "\nBook is not available." << endl;
        books::unsuccessfulTransactions++;
    }

    // Example of price update
    book1.changePrice(400);

    books::showStatistics();

    return 0;
}
